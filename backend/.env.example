# Folder that FileFlow watches and organizes.
# Defaults to a safe sandbox folder inside the project so nothing in your
# real Downloads folder is touched until you deliberately point this at it.
WATCH_FOLDER=./sample_downloads

HOST=127.0.0.1
PORT=8000

# Comma-separated origins allowed to call the API / connect the websocket.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional real RPA integration: when enabled, the physical file-move step
# is executed by UiPath Robot instead of a plain Python shutil.move. Off by
# default. Requires UiPath Robot installed + signed in, and the
# uipath/FileFlowMove project packed to a .nupkg (uip rpa pack).
UIPATH_ENABLED=false
# The Robot lives in a VERSIONED folder that UiPath's auto-updater replaces --
# re-check this path after any UiPath update, or every move will log "UiPath
# Robot invocation failed to start" and quietly use the plain Python move.
UIPATH_ROBOT_EXE=C:\Program Files\UiPathPlatform\Robot\<version>\UiRobot.exe
UIPATH_PACKAGE_PATH=C:\path\to\FileFlowMove.<version>.nupkg
UIPATH_ENTRY_POINT=MoveFile.xaml

# Brute-force / spam protection on /api/auth/login, /register and
# /forgot-password, per caller IP. These defaults are sensible -- uncomment
# only to tune them.
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# REGISTER_RATE_LIMIT_MAX=5
# REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
# PASSWORD_RESET_RATE_LIMIT_MAX=5
# PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600

# Base URL of the deployed frontend -- used to build the link inside the
# "forgot password" email. Defaults to the local Vite dev server.
FRONTEND_URL=http://localhost:5173

# How long (minutes) a password reset link stays valid.
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# Outgoing email (weekly digest, password reset) via SMTP. For Gmail:
# enable 2-Step Verification, then create an App Password at
# myaccount.google.com/apppasswords and use it as SMTP_PASSWORD -- your
# normal Gmail password won't work here. Sending is skipped entirely
# until both SMTP_USERNAME and SMTP_PASSWORD are set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youraccount@gmail.com
SMTP_PASSWORD=your16charapppassword
# Defaults to SMTP_USERNAME if unset.
# SMTP_FROM_EMAIL=youraccount@gmail.com

# One shared AI provider backs three advisory-only features: AI Rule
# Generator ("Create with AI" on the Rules page), AI Unclassified File
# Suggestions, and Natural Language File Search's query interpretation.
# None of them ever save a rule, move a file, or search the filesystem
# themselves -- each only produces a proposal/suggestion/structured query
# for FileFlow's own deterministic code to validate and act on. Leaving
# the relevant API key unset doesn't break anything else; each feature
# just responds with "AI service is not configured" / is temporarily
# unavailable.
#
# AI_PROVIDER selects which one is actually used -- "anthropic" (default)
# or "gemini". Only the matching key below needs to be set.
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini
GEMINI_API_KEY=
# AI_PROVIDER_MODEL=claude-haiku-4-5-20251001 (anthropic) / gemini-3.6-flash (gemini)
# AI_PROVIDER_BASE_URL=https://api.anthropic.com/v1/messages
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
# AI_PROVIDER_TIMEOUT_SECONDS=20

# Per-IP rate limits, one fixed window per feature (api/rate_limit.py) --
# uncomment only to tune them.
# AI_RULE_GENERATE_RATE_LIMIT_MAX=20
# AI_RULE_GENERATE_RATE_LIMIT_WINDOW_SECONDS=3600
# AI_UNCLASSIFIED_RATE_LIMIT_MAX=20
# AI_UNCLASSIFIED_RATE_LIMIT_WINDOW_SECONDS=3600
# AI_UNCLASSIFIED_MAX_BATCH_SIZE=15
# AI_FILE_SEARCH_RATE_LIMIT_MAX=20
# AI_FILE_SEARCH_RATE_LIMIT_WINDOW_SECONDS=3600

# Smart Duplicate Groups / Natural Language File Search: purely
# deterministic, no AI/rate limiting involved -- these only bound how much
# detail a single response returns (summary counts always reflect the full
# scan; `truncated` discloses when a cap was hit).
# DUPLICATE_ANALYSIS_MAX_GROUPS_RETURNED=50
# FILE_SEARCH_MAX_RESULT_LIMIT=100
