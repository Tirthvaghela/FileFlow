# Python
backend/venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
frontend/node_modules/
frontend/dist/

# UiPath -- Studio's local cache/docs (regenerated on open), and built packages
uipath/*/.local/
uipath/.packages/

# Environment
.env
backend/.env
frontend/.env
# Holds a real long-lived agent bearer token -- never committed.
agent/config.json
# This machine's own local agent state -- never something to commit.
agent/agent_queue.db
agent/rules_cache.json
# PyInstaller/Inno Setup build output -- regenerated from source, not
# something to track in git.
build/
dist/
agent/installer/Output/

# Runtime data
database/*.db
backend/logs/*.log
backend/sample_downloads/*
!backend/sample_downloads/.gitkeep

# Editor/OS
.vscode/
.DS_Store
Thumbs.db

# Claude Code / IDE tooling data (not part of the project)
.agents/
.claude/
skills-lock.json
