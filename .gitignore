# Python
backend/venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
frontend/node_modules/
frontend/dist/

# UiPath -- Studio's local cache/docs (regenerated on open), and built packages
uipath/*/.local/
uipath/.packages/

# Environment
.env
backend/.env
frontend/.env
# Holds a real long-lived agent bearer token -- never committed.
agent/config.json
# This machine's own local agent state -- never something to commit.
agent/agent_queue.db
agent/rules_cache.json
# PyInstaller/Inno Setup build output -- regenerated from source, not
# something to track in git.
build/
dist/
agent/installer/Output/

# Runtime data
database/*.db
backend/logs/*.log
backend/sample_downloads/*
!backend/sample_downloads/.gitkeep

# UiPath FileFlow demo run output -- regenerated by actually running Main.xaml
# (see README "UiPath standalone demo"); .gitkeep is what keeps the folder
# present and empty after a fresh clone, so it's the one exception.
uipath/FileFlow/TestDownloads/*
!uipath/FileFlow/TestDownloads/.gitkeep
uipath/FileFlow/ActivityLog.csv

# Microsoft Office temp/lock files -- created next to whatever .docx/.pptx/
# .xlsx happens to be open, which has included this repo's own root.
~$*
mso*.tmp

# Editor/OS
.vscode/
.DS_Store
Thumbs.db

# Claude Code / IDE tooling data (not part of the project)
.agents/
.claude/
skills-lock.json
